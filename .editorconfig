# Stop scanning up directories for more properties to set
root = true

[*]
# These properties are 100% required for editorconfig support
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# YAML Files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown Files
[*.{md,mdx}]
indent_style = space
trim_trailing_whitespace = false

# Batch Files
[*.{cmd,bat}]
end_of_line = crlf

# This property is optional and IDE specific
max_line_length = 100